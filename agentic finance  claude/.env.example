# SpreadLens AI — environment template. Copy to engine/.env (engine) and set the web/agent values in your shell.
# No secrets here. In deployment, secrets come from a secret manager (e.g. Google Secret Manager via --set-secrets).

# ---------------- engine (Python / FastAPI) ----------------
SPREADLENS_ENV=development
# Docker Compose Postgres. Without Docker run `uv run python -m spreadlens.devdb`, which writes engine/.env for you.
SPREADLENS_DATABASE_URL=postgresql+psycopg://spreadlens:spreadlens@localhost:5433/spreadlens
SPREADLENS_TEST_DATABASE_URL=postgresql+psycopg://spreadlens:spreadlens@localhost:5433/spreadlens_test
SPREADLENS_STORAGE_BACKEND=local            # local | gcs
SPREADLENS_STORAGE_ROOT=./data/files
# SPREADLENS_GCS_BUCKET=                    # when STORAGE_BACKEND=gcs (ADC credentials, no key files)

# demo = deterministic adapters, no model credentials, nothing leaves the machine
# live = eve agents via Vercel AI Gateway. A failed live call fails the stage; it never falls back to demo.
SPREADLENS_AGENT_MODE=demo
SPREADLENS_EVE_DOCUMENT_UNDERSTANDING_URL=http://127.0.0.1:3101
SPREADLENS_EVE_TABLE_EXTRACTION_URL=http://127.0.0.1:3102
SPREADLENS_EVE_FINANCIAL_MAPPING_URL=http://127.0.0.1:3103
SPREADLENS_EVE_RECONCILIATION_URL=http://127.0.0.1:3104
SPREADLENS_EVE_ANALYST_PACK_URL=http://127.0.0.1:3105
SPREADLENS_EVE_SERVICE_TOKEN=change-me-random-32-chars            # engine -> eve agents (must equal EVE_SERVICE_TOKEN)
SPREADLENS_AGENT_TOOL_TOKEN=change-me-another-random-32-chars     # eve tools -> engine internal tools

SPREADLENS_OCR_PROVIDER=local               # local (RapidOCR on this machine) | none
SPREADLENS_OCR_DPI=150

SPREADLENS_MAX_UPLOAD_BYTES=26214400
SPREADLENS_MAX_PDF_PAGES=200
SPREADLENS_BUDGET_MAX_MODEL_CALLS=40
SPREADLENS_BUDGET_MAX_COST_USD=2.00
SPREADLENS_BUDGET_MAX_OCR_PAGES=60
SPREADLENS_WORKER_CONCURRENCY=4
SPREADLENS_RUN_WORKER_IN_API=true           # compose sets false and runs a separate worker

SPREADLENS_SEED_PASSWORD=spreadlens-demo    # LOCAL DEMO USERS ONLY
SPREADLENS_LOG_LEVEL=INFO
# SPREADLENS_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
SPREADLENS_MODEL_PRICE_INPUT_PER_MTOK=3.0
SPREADLENS_MODEL_PRICE_OUTPUT_PER_MTOK=15.0

# ---------------- web (Next.js BFF) ----------------
ENGINE_URL=http://127.0.0.1:8000
COOKIE_SECURE=false

# ---------------- agent-runtime (eve, live mode only) ----------------
AI_GATEWAY_API_KEY=                         # Vercel AI Gateway key (live mode only)
SPREADLENS_EVE_MODEL=anthropic/claude-sonnet-5
# Per-agent overrides, e.g. SPREADLENS_EVE_MODEL_FINANCIAL_MAPPING=anthropic/claude-opus-5.5
EVE_SERVICE_TOKEN=change-me-random-32-chars
SPREADLENS_ENGINE_URL=http://127.0.0.1:8000
