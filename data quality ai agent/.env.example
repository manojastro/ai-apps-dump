# Local defaults require no paid credentials. Copy this file to .env.
DEMO_MODE=true
DEMO_FORCE_FIRST_FIX_FAIL=false
MAX_REMEDIATION_ATTEMPTS=3
DATABASE_URL=sqlite:///.runtime/recoverygraph.db
CHECKPOINT_URL=.runtime/checkpoints.db

# Explicit provider selection enables online proposals; validators stay deterministic.
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
LLM_TIMEOUT_SECONDS=30
# Optional pricing: set both values in your environment, USD per million tokens.
# LLM_INPUT_COST_PER_MILLION=0
# LLM_OUTPUT_COST_PER_MILLION=0

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
# Optional local access token. The console accepts it in Connection settings.
API_TOKEN=
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]
WRITE_REQUESTS_PER_MINUTE=60

# Docker Compose database is isolated from host networking.
POSTGRES_USER=recoverygraph
POSTGRES_PASSWORD=recoverygraph_local_only
POSTGRES_DB=recoverygraph
BACKEND_PORT=8000
FRONTEND_PORT=8080
# Optional OTLP HTTP collector, e.g. http://localhost:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
