# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# Salesforce target — MUST be sandbox or Developer Edition. Production is refused.
SALESFORCE_INSTANCE_URL=https://your-dev-org.develop.my.salesforce.com
# Comma-separated allowlist. Browser may ONLY visit these domains.
SENTINEL_ALLOWED_DOMAINS=your-dev-org.develop.my.salesforce.com
# Budget kill switch (enforced in code, not in prompt)
SENTINEL_MAX_TOKENS_PER_RUN=100000
SENTINEL_MAX_COST_USD_PER_RUN=5.00
# Integrations (Phase 3+)
JIRA_URL=
JIRA_USER=
JIRA_API_TOKEN=
GITHUB_TOKEN=
GITHUB_REPO=
SLACK_WEBHOOK_URL=
