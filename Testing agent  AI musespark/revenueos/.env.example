# Copy to .env. Never commit .env. All values below are placeholders.
ENVIRONMENT=dev
DATABASE_URL=postgresql+psycopg://revenueos:revenueos@localhost:5432/revenueos
POSTGRES_USER=revenueos
POSTGRES_PASSWORD=revenueos
POSTGRES_DB=revenueos

# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me
JWT_EXPIRE_MINUTES=480
# Password given to every synthetic demo user when data is loaded.
DEMO_USER_PASSWORD=replace-me

# The copilot returns HTTP 503 until a key is set.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_MAX_TOOL_TURNS=8

# "Today" for the synthetic world, so results are reproducible.
DATA_AS_OF=2026-10-31
COPILOT_RATE_LIMIT_PER_MINUTE=20
ENABLE_SCHEDULER=false
CORS_ORIGINS=http://localhost:3000
MLFLOW_TRACKING_URI=
