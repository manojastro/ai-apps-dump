# Copy to .env (git-ignored) and fill in. Never commit .env.
# Every value here is a placeholder. All project data is synthetic.

# --- Runtime switches ---
# Backend: local | databricks
INVOICEFLOW_BACKEND=local
# Kill switch: true routes every case to the manual queue. Re-read per case, no redeploy.
INVOICEFLOW_KILL_SWITCH=false
# Local SQLite stores (checkpoints, audit, cases, drafts, ERP sandbox, dev tokens)
INVOICEFLOW_STATE_DIR=.invoiceflow

# --- Local backend: Docker Compose Postgres + pgvector ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=invoiceflow
POSTGRES_USER=invoiceflow
POSTGRES_PASSWORD=<local-dev-password>

# --- Databricks ---
# Prefer the CLI profile created by `databricks auth login --profile invoiceflow`
# over personal access tokens.
DATABRICKS_CONFIG_PROFILE=invoiceflow
DATABRICKS_WAREHOUSE_ID=<sql-warehouse-id>
INVOICEFLOW_CATALOG=invoiceflow
INVOICEFLOW_SCHEMA=ap
INVOICEFLOW_EVAL_SCHEMA=eval
INVOICEFLOW_VOLUME=raw
AI_SEARCH_ENDPOINT=<ai-search-endpoint-name>
AI_SEARCH_INDEX=<catalog.schema.policy_index>

# --- LLM: model names live only in config, never in code ---
# Provider: stub | databricks | azure_openai
LLM_PROVIDER=stub
# Take these names from `databricks serving-endpoints list` in your workspace.
LLM_ENDPOINT=<serving-endpoint-name>
EMBEDDING_ENDPOINT=<embedding-endpoint-name>
# For cost reports; set from your price sheet (0 = not priced).
LLM_COST_PER_1K_INPUT_TOKENS=0
LLM_COST_PER_1K_OUTPUT_TOKENS=0

# --- Azure OpenAI (optional) ---
# AZURE_OPENAI_API_KEY comes from the environment or Key Vault, never from this file.
AZURE_OPENAI_ENDPOINT=<https://your-resource.openai.azure.com>
AZURE_OPENAI_DEPLOYMENT=<deployment-name>
AZURE_OPENAI_API_VERSION=<api-version>

# --- Agent budgets (exceeding any routes the case to the manual queue) ---
AGENT_MAX_TOOL_STEPS=12
AGENT_MAX_TOKENS=60000
AGENT_MAX_SECONDS=120
AGENT_MAX_TOOL_RETRIES=2

# --- Approval service: dev (random local tokens) | oidc (Entra ID, see docs/ENTRA_SETUP.md) ---
APPROVALS_AUTH=dev
OIDC_ISSUER=<https://login.microsoftonline.com/tenant-id/v2.0>
OIDC_AUDIENCE=<api://invoiceflow-approvals>
OIDC_JWKS_URL=<https://login.microsoftonline.com/tenant-id/discovery/v2.0/keys>

# --- Observability ---
# true: MLflow spans for each agent step (inputs/outputs masked)
MLFLOW_TRACING=false
MLFLOW_TRACKING_URI=<databricks | http://localhost:5000 | file:./mlruns>
