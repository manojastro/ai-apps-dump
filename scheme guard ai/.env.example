# Copy to .env. Every value here is optional; defaults run fully offline with the fake LLM + SQLite.

# --- storage ---
# Empty = SQLite at .schemaguard/state.db. Set to use Postgres (pip extra: schemaguard[postgres]).
SCHEMAGUARD_DATABASE_URL=
# SCHEMAGUARD_DATABASE_URL=postgresql://schemaguard:schemaguard@localhost:5432/schemaguard

# --- schema registry ---
# Empty = file registry at .schemaguard/registry. Set to use Confluent Schema Registry.
SCHEMAGUARD_REGISTRY_URL=
# SCHEMAGUARD_REGISTRY_URL=http://localhost:8081

# --- LLM ---  fake | azure | openai | anthropic
SCHEMAGUARD_LLM_PROVIDER=fake
SCHEMAGUARD_LLM_MODEL=
SCHEMAGUARD_AZURE_OPENAI_ENDPOINT=
SCHEMAGUARD_AZURE_OPENAI_DEPLOYMENT=
SCHEMAGUARD_AZURE_OPENAI_API_VERSION=2024-10-21
# Provider keys use the providers' standard env var names:
AZURE_OPENAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- budgets ---
SCHEMAGUARD_RUN_BUDGET_USD=0.50
SCHEMAGUARD_RUN_BUDGET_TOKENS=200000
SCHEMAGUARD_MAX_FIX_RETRIES=3

# --- GitHub draft PRs (only used after a human approves a run) ---
SCHEMAGUARD_GITHUB_TOKEN=
SCHEMAGUARD_GITHUB_REPO=

# --- observability ---
SCHEMAGUARD_OTEL_CONSOLE=false
SCHEMAGUARD_LOG_LEVEL=INFO
# Optional LangSmith tracing (LangGraph reads these directly):
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=

# --- UI ---
SCHEMAGUARD_API_URL=http://localhost:8000
