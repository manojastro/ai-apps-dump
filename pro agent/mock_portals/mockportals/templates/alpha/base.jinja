<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{% block title %}Alpha Supply{% endblock %} | Alpha Supply</title>
<style>
body{font-family:Georgia,serif;margin:0;background:#f4f6fa;color:#1d2433}
header{background:#123c7a;color:#fff;padding:12px 24px;display:flex;gap:24px;align-items:center}
header a{color:#fff}.brand{font-size:20px;font-weight:bold;letter-spacing:.5px}
.synthetic{background:#ffd54f;color:#000;padding:4px 24px;font-size:13px}
main{max-width:980px;margin:20px auto;background:#fff;padding:20px 28px;border:1px solid #d7dce5}
table{border-collapse:collapse;width:100%}th,td{border:1px solid #ccd3df;padding:6px 8px;text-align:left}
th{background:#e8edf6}dl{display:grid;grid-template-columns:220px 1fr;gap:6px 12px}dt{font-weight:bold}
.btn{background:#123c7a;color:#fff;border:0;padding:8px 16px;cursor:pointer;font-size:15px;text-decoration:none;display:inline-block}
.error{color:#a00}.notice{background:#eef;padding:8px}.promo-notice{border:2px dashed #c00;padding:8px;margin:12px 0}
</style></head><body>
<header><span class="brand">ALPHA SUPPLY</span>
<nav aria-label="Primary"><a href="{{ r.search }}">Catalog</a> · <a href="{{ r.cart }}">Basket</a> · <a href="{{ r.orders }}">My orders</a>{% if account %} · <a href="{{ r.logout }}">Sign out</a>{% endif %}</nav></header>
<div class="synthetic" role="note">Synthetic demo supplier. No real products, prices or payments.</div>
<main>{% block body %}{% endblock %}</main></body></html>
