{% extends "alpha/base.jinja" %}{% block title %}Verification{% endblock %}{% block body %}
<h1>Two-step verification</h1><p>Enter the 6-digit code sent to your registered device.</p>
{% if error %}<p class="error" role="alert">{{ error }}</p>{% endif %}
<form method="post" action="{{ r.otp }}"><label for="code">Verification code</label> <input id="code" name="code" inputmode="numeric">
<button class="btn" type="submit">Verify</button></form>{% endblock %}
