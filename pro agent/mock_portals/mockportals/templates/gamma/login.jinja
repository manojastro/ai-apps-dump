{% extends "gamma/base.jinja" %}{% block title %}Login{% endblock %}{% block body %}
<h1>Partner login</h1>
{% if notice %}<p class="err" role="status">{{ notice }}</p>{% endif %}
{% if error %}<p class="err" role="alert">{{ error }}</p>{% endif %}
<form method="post" action="{{ r.login }}"><table class="grid">
<tr><th><label for="u">User name</label></th><td><input id="u" name="username" autocomplete="username"></td></tr>
<tr><th><label for="p">Password</label></th><td><input id="p" name="password" type="password" autocomplete="current-password"></td></tr>
</table><p><button class="button" type="submit">Login</button></p></form>{% endblock %}
