<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{% block title %}Beta Devices{% endblock %} — Beta Devices</title>
<style>
*{box-sizing:border-box}body{font-family:system-ui,Segoe UI,sans-serif;margin:0;background:#0f1115;color:#e9ecf1}
.top{display:flex;justify-content:space-between;align-items:center;padding:14px 28px;background:#1a1d24;border-bottom:3px solid #18c29c}
.logo{font-weight:800;font-size:22px;color:#18c29c}.top a{color:#cfd6e2;margin-left:16px;text-decoration:none}
.demo{background:#18c29c;color:#04140f;text-align:center;font-size:12px;padding:3px}
.wrap{max-width:1100px;margin:24px auto;padding:0 20px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px}
.card{background:#1a1d24;border-radius:12px;padding:16px}.card a{color:#9fe8d6}
.chips{display:flex;flex-wrap:wrap;gap:6px;padding:0;list-style:none}.chips li{background:#2a2f3a;border-radius:99px;padding:4px 10px;font-size:13px}
.cta{background:#18c29c;color:#04140f;border:0;border-radius:8px;padding:10px 18px;font-weight:700;cursor:pointer;text-decoration:none;display:inline-block}
input,select{background:#0f1115;color:#e9ecf1;border:1px solid #3a4150;border-radius:6px;padding:8px}
.row{display:flex;justify-content:space-between;border-bottom:1px solid #2a2f3a;padding:6px 0}
.alert{background:#4a1d1d;padding:10px;border-radius:8px}.promo-notice{border:2px dashed #ff7b7b;padding:10px;margin:12px 0}
</style></head><body>
<div class="top"><span class="logo">beta/devices</span>
<nav aria-label="Account"><a href="{{ r.search }}">Shop</a><a href="{{ r.cart }}">Cart</a><a href="{{ r.orders }}">Orders</a>{% if account %}<a href="{{ r.logout }}">Log out</a>{% endif %}</nav></div>
<div class="demo" role="note">SYNTHETIC SUPPLIER FOR DEMONSTRATION — prices and stock are fictional</div>
<div class="wrap"><main>{% block body %}{% endblock %}</main></div></body></html>
