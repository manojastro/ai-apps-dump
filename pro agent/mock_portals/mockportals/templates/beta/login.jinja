{% extends "beta/base.jinja" %}{% block title %}Log in{% endblock %}{% block body %}
<div class="card" style="max-width:420px">
<h1>Welcome back</h1>
{% if notice %}<p class="alert" role="status">{{ notice }}</p>{% endif %}
{% if error %}<p class="alert" role="alert">{{ error }}</p>{% endif %}
<form method="post" action="{{ r.login }}">
<p><label>Account ID<br><input name="username" autocomplete="username"></label></p>
<p><label>Password<br><input name="password" type="password" autocomplete="current-password"></label></p>
<button class="cta" type="submit">Log in</button></form></div>{% endblock %}
