{% extends "beta/base.jinja" %}{% block title %}Security check{% endblock %}{% block body %}
<div class="card" style="max-width:420px"><h1>Security check</h1><p>We sent a one-time passcode to your authenticator app.</p>
{% if error %}<p class="alert" role="alert">{{ error }}</p>{% endif %}
<form method="post" action="{{ r.otp }}"><label>One-time passcode <input name="code" inputmode="numeric"></label>
<button class="cta" type="submit">Confirm</button></form></div>{% endblock %}
