# Procurement Navigator configuration. Copy to .env and edit. Never commit .env.
# Defaults are safe for local demo: fixture model mode and DRY_RUN=true.

APP_ENV=development                # development | test | production
APP_BASE_URL=http://localhost:5273
# Runtime role (non-owner; row-level security applies) and migration/owner role.
APP_DATABASE_URL=postgresql+psycopg://procnav_app:devapp@127.0.0.1:55433/procnav
APP_MIGRATION_DATABASE_URL=postgresql+psycopg://procnav_owner:devowner@127.0.0.1:55433/procnav
SESSION_SECRET=dev-session-secret-change-me   # production: >= 32 random characters
COOKIE_SECURE=false                           # production: true (TLS)
CREDENTIALS_KEY=                              # Fernet key for stored browser session state; required in production
                                              #   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"

# Model
MODEL_MODE=fixture                 # fixture (deterministic, offline, labelled simulated) | real
MODEL_PROVIDER=anthropic
MODEL_NAME=claude-opus-5-5
MODEL_ENDPOINT=                    # optional override of the API base URL
MODEL_API_KEY=                     # required when MODEL_MODE=real
MODEL_VISION_ENABLED=true

# Browser and budgets
BROWSER_ALLOWED_ORIGINS=http://127.0.0.1:8301,http://127.0.0.1:8302,http://127.0.0.1:8303
BROWSER_HEADLESS=true
MAX_BROWSER_ACTIONS=80
ACTIVE_RUN_TIMEOUT_SECONDS=900
MAX_RUN_COST=1.00                  # USD per run
MAX_CONCURRENT_RUNS=2
APPROVAL_TTL_SECONDS=3600
DRY_RUN=true                       # only simulated suppliers are supported in this release

# Supplier credentials by reference (prefer a secret store). JSON: {"supplier/acme/alpha": {"username": "...", "password": "..."}}
SUPPLIER_CREDENTIALS_JSON=

# Synthetic supplier fixture service (operator/evaluator only; never exposed publicly)
FIXTURE_CONTROL_URL=http://127.0.0.1:8309
FIXTURE_CONTROL_TOKEN=dev-control-token
SUPPLIERS_DATABASE_URL=postgresql+psycopg://suppliers:devsuppliers@127.0.0.1:55433/suppliers

# Seed command
DEMO_PASSWORD=                     # dev default is procnav-demo; production generates and prints one

# Observability (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Docker compose secrets
POSTGRES_PASSWORD=devpostgres
PROCNAV_OWNER_PASSWORD=devowner
PROCNAV_APP_PASSWORD=devapp
SUPPLIERS_DB_PASSWORD=devsuppliers
DOMAIN=                            # production reverse proxy hostname
ACME_EMAIL=
