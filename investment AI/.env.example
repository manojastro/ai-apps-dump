# Application
APP_ENV=local
DATA_MODE=mock
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=sqlite:///./data/aegis.db
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# LLM (OpenAI-compatible). Defaults target SpaceXAI / xAI when live.
LLM_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4.5
XAI_API_KEY=

# Firecrawl (unused in DATA_MODE=mock)
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
FIRECRAWL_MAX_CALLS_PER_PLAN=8
CACHE_TTL_SECONDS=21600

# Budgets
MAX_LLM_CALLS_PER_PLAN=12
MAX_PLAN_RUNTIME_SECONDS=180
MAX_RETRIES=2
VDA_OPT_IN_CAP_PCT=3
CONCENTRATION_CAP_PCT=15
SOURCE_COVERAGE_VETO_PCT=30

# Frontend
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Aegis Plan India
