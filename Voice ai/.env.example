# Copy to .env. Never commit .env.
EIR_LLM_MODE=MOCK              # MOCK (default, free, offline) or REAL
ANTHROPIC_API_KEY=             # only needed when EIR_LLM_MODE=REAL
EIR_MODEL=claude-sonnet-5-5
EIR_DB_URL=sqlite:///data/eir.db
EIR_APPROVAL_TTL_HOURS=48
PHOENIX_COLLECTOR_ENDPOINT=    # e.g. http://localhost:6006/v1/traces (optional)
EIR_SESSION_SECRET=change-me-demo-only
