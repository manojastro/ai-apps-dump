# Optional shared server keys. Visitors can also paste their own key in the app's Settings.
# Never commit a real key: copy this file to .env (which git ignores) and fill it in there.

# Claude (Anthropic)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Any OpenAI-compatible API. Defaults to APInex serving DeepSeek V4 Flash.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.apinex.bond/v1
# OPENAI_MODEL=deepseek-v4-flash

# Which provider to use when a visitor hasn't picked one: anthropic or openai
# (if unset: openai when only OPENAI_API_KEY is set, otherwise anthropic)
# AI_PROVIDER=openai

PORT=3000

# Spending protection, applied only when the shared key above is used
# (requests with the visitor's own key are never limited).
LIMIT_RESUME_PER_HOUR=5     # resumes per visitor per hour
LIMIT_CHAT_PER_HOUR=30      # chat messages per visitor per hour
LIMIT_DAILY_TOTAL=300       # all AI requests per day, across everyone
# REQUIRE_USER_KEY=true     # never use the shared key; visitors must bring their own
