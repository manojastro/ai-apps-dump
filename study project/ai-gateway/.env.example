# --- Gateway settings (all synthetic / local defaults; no secrets here) ---
ADMIN_API_KEY=admin-dev-key-change-me
DATABASE_PATH=data/gateway.db
# In mock-first slice the gateway uses SQLite + in-memory Redis stub.
# docker-compose sets REDIS_URL=redis://redis:6379/0 to use the real Redis service.
REDIS_URL=memory://stub
PRICES_PATH=config/prices.yaml
ROUTING_POLICY_PATH=config/routing_policy.yaml
GUARDRAIL_PROFILES_PATH=config/guardrail_profiles.yaml
CACHE_TTL_S=300
MAX_USD_PER_RUN=5
