  "hype_vs_reality": [
    {
      "item": "MCP",
      "verdict": "Real differentiator, not universal table stakes",
      "required_examples": ["TCS Hyderabad", "PwC Acceleration Centers", "SAP Bangalore", "OpenAI Agent Enablement", "GRAIL", "G-Research", "Workfall", "Platlap"],
      "preferred_examples": ["Google Cloud FDE", "Atos ServiceNow FDE"],
      "absent_in": ["Most Cognizant/Infosys/Deloitte/Siemens/WSP inspected JDs"]
    },
    {
      "item": "A2A",
      "verdict": "Rare keyword (TCS required, Atos preferred). Not market-wide."
    },
    {
      "item": "LangGraph vs LangChain",
      "verdict": "LangGraph is the 2026 agent-framework signal; LangChain remains the umbrella. CrewAI/AutoGen almost always OR-list padding."
    },
    {
      "item": "Google ADK / OpenAI Agents SDK / PydanticAI",
      "verdict": "Vendor-native or niche. ADK almost only on Google FDE + Modus. Agents SDK on PwC AC, NVIDIA RAG, Dataiku. PydanticAI on 3 JDs."
    },
    {
      "item": "RAG vs agents",
      "verdict": "RAG still the default architecture (42/50). Many 'agentic' JDs are tool-calling RAG plus orchestration."
    },
    {
      "item": "Kubernetes",
      "verdict": "Platform/senior filter, not universal for India 4-6yr SI GenAI roles."
    },
    {
      "item": "FastAPI brand",
      "verdict": "Named on 10/50; REST APIs on 38/50. Teach backend engineering, not the brand."
    },
    {
      "item": "Eval",
      "verdict": "Quality split: Google FDE, OpenAI ADE, Anthropic Agents, Cognizant official require it. Most Naukri SI dumps omit it."
    },
    {
      "item": "Accenture volume",
      "verdict": "2283 Naukri hits include empty LLM Architect templates ('Good to have: NA'). Not 2283 unique architecture seats."
    },
    {
      "item": "Qdrant",
      "verdict": "0 mentions in N=50. Pinecone is the JD brand; pgvector appears in production-minded product JDs."
    }
  ],
