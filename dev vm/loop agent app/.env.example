# DataSentinel AI configuration
# Copy to .env and adjust. Demo mode works with LLM_PROVIDER=mock and no API key.

APP_ENV=demo
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# sqlite+pysqlite:///./data/datasentinel.db
# postgresql+psycopg2://datasentinel:datasentinel@postgres:5432/datasentinel
DATABASE_URL=sqlite+pysqlite:///./data/datasentinel.db
WAREHOUSE_PATH=./data/warehouse.duckdb
CHECKPOINT_PATH=./data/checkpoints.sqlite

# mock | spacexai | openai | anthropic
LLM_PROVIDER=mock
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=

LLM_FAST_MODEL=grok-4.5
LLM_REASONING_MODEL=grok-4.6

# Bounded autonomy
MAX_RCA_ITERATIONS=8
MAX_HYPOTHESES=6
MAX_REMEDIATION_ATTEMPTS=3
MAX_RECOVERY_CYCLES=2
MAX_LLM_CALLS=20
MAX_TOOL_CALLS=50
MAX_INCIDENT_COST_USD=1.00
MAX_EXECUTION_TIME_SEC=120
ROOT_CAUSE_CONFIDENCE_THRESHOLD=0.90

LOG_LEVEL=INFO
SEED=42
