# Copy to .env and fill in. NEVER commit real keys.

# --- LLM (leave blank to run with the offline mock LLM) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Pinecone vector DB (leave blank to boot in degraded mode: refusals only) ---
PINECONE_API_KEY=
PINECONE_INDEX=support-copilot
PINECONE_REGION=us-east-1
PINECONE_CLOUD=aws
# Optional namespace override for ingestion queries
PINECONE_NAMESPACE=

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Optional tuning ---
# MEMORY_WINDOW_TURNS=5
# RETRIEVER_SCORE_THRESHOLD=0.75
# RATE_LIMIT_CAPACITY=30
# RATE_LIMIT_REFILL_PER_SEC=1.0
# CORS_ALLOW_ORIGINS=*
# LOG_LEVEL=INFO
