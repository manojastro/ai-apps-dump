# ---------------------------------------------------------------------------
# Application under test
# ---------------------------------------------------------------------------
BASE_URL=https://www.saucedemo.com

# Demo-app credentials (override per environment; never commit real secrets)
E2E_USERNAME=standard_user
E2E_PASSWORD=secret_sauce
E2E_LOCKED_USER=locked_out_user

# ---------------------------------------------------------------------------
# Self-healing engine
# ---------------------------------------------------------------------------
SELECTOR_HISTORY_PATH=selector-history.json
HEAL_EVENTS_DIR=test-results/healing-events

# ---------------------------------------------------------------------------
# Jira integration (scripts/create-jira-bug.ts + CI failure step)
# Use a scoped API token: https://id.atlassian.com/manage-profile/security/api-tokens
# ---------------------------------------------------------------------------
JIRA_HOST=your-company.atlassian.net
JIRA_EMAIL=cie2e-bot@your-company.com
JIRA_API_TOKEN=replace-me
JIRA_PROJECT_KEY=E2E
JIRA_ISSUE_TYPE=Bug
JIRA_PRIORITY=Medium
