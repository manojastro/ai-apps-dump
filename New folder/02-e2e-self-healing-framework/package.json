{
  "name": "e2e-self-healing-framework",
  "version": "1.0.0",
  "description": "Enterprise E2E test automation framework with a self-healing locator engine (Playwright + TypeScript + Jira integration).",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:parallel": "playwright test --workers=8",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "jira:create-bug": "tsx scripts/create-jira-bug.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
