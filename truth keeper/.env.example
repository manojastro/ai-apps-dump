# Copy to .env (never commit .env). Everything works offline with the defaults below.

# mock = deterministic fixture responses, zero cost, no network (default)
# real = call Claude through the Anthropic SDK (needs ANTHROPIC_API_KEY)
LLM_MODE=mock
ANTHROPIC_API_KEY=

# Model + request settings (used only when LLM_MODE=real)
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_MAX_TOKENS=2048
# Ask the API to constrain output to the Proposal JSON schema (we still validate with Pydantic)
LLM_STRUCTURED_OUTPUT=true
# Server-side refusal fallback (beta) - on by default
LLM_USE_FALLBACKS=true
# Prices in USD per million tokens, used for cost-per-conflict reporting
LLM_PRICE_INPUT_PER_MTOK=4.00
LLM_PRICE_OUTPUT_PER_MTOK=20.00

# Active prompt version for the pipeline / UI
PROMPT_VERSION=v1

# Mock fault injection profile: clean | noisy  (noisy exercises retries/failures)
MOCK_PROFILE=clean

# Tracing: leave empty to disable. Local Phoenix: http://localhost:6006
PHOENIX_COLLECTOR_ENDPOINT=

# Paths (defaults shown)
TK_GENERATED_DIR=data/generated
TK_SANDBOX_DIR=data/sandbox
TK_STATE_DB=data/state.db
TK_GROUND_TRUTH=data/generator/ground_truth.json
