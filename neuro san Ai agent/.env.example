# Copy to .env and fill real values. NEVER commit .env.
# See docs/FRAMEWORK_FACTS.md §11 (GOOGLE_API_KEY only) and docs/DECISIONS.md D006/D007.

# --- Gemini (Google AI Studio) — canonical key, server-side only ---
GOOGLE_API_KEY="YOUR_GOOGLE_GEMINI_API_KEY"

# --- Neuro SAN server / nsflow (defaults match `ns run`) ---
NEURO_SAN_SERVER_HOST="localhost"
NEURO_SAN_SERVER_HTTP_PORT="8080"
NSFLOW_HOST="localhost"
NSFLOW_PORT="4173"
AGENT_MANIFEST_FILE="./registries/manifest.hocon"
AGENT_TOOL_PATH="./coded_tools"
THINKING_FILE="/tmp/agent_thinking.txt"

# --- App ---
LOG_LEVEL="INFO"
DB_PATH="./data/autopilot.db"

# --- ServiceNow PDI (Table API). Canonical names win; _ALIAS forms supported for compat. ---
SERVICENOW_INSTANCE_URL="https://YOUR-INSTANCE.service-now.com/"
SERVICENOW_USER="YOUR_SERVICENOW_USER"
SERVICENOW_PWD="YOUR_SERVICENOW_PASSWORD"
# Aliases (optional, only used if canonical missing):
# SERVICENOW_INSTANCE="https://YOUR-INSTANCE.service-now.com/"
# SERVICENOW_USERNAME="YOUR_SERVICENOW_USER"
# SERVICENOW_PASSWORD="YOUR_SERVICENOW_PASSWORD"
