# Compose: generate unique passwords with python scripts/docker_env.py.
POSTGRES_PASSWORD=
DEMO_DB_PASSWORD=
DEMO_CONTROL_TOKEN=
# Backend only. Empty credentials keep live mode unavailable.
MODEL_API_KEY=
MODEL_ID=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_ALLOWED_HOSTS=api.openai.com
# Explicit development exception only; never permit metadata addresses.
MODEL_DEV_HOSTS=
# TLS deployment should set secure cookies and its exact public origin.
SECURE_COOKIES=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
